{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "bar.menu"
        },
        {
          "id": "bar.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm",
          "formatAlt": "ddd d MMM",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.spacer",
          "size": 8
        },
        {
          "id": "harshith.system-monitor",
          "barMode": "CPU"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.spacer",
          "size": 8
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "better.displays"
        },
        {
          "id": "bar.power",
          "showPercentage": true
        },
        {
          "id": "omarchy.spacer",
          "size": 4
        },
        {
          "id": "jankeesvw.notification-center"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "gmaxxxie.fcitx5-theme"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "bar.menu"
  ]
}
