#!/usr/bin/python3
"""omarchy-lcd-bg - show the current theme's backgrounds on the case LCD panels.

Two panels, two unrelated protocols, one daemon:

  Thermaltake 6" LCD Panel Kit   USB HID 264a:2347.  1110x540 baseline JPEG
                                 over the "BY" protocol.  Framing adapted from
                                 deniswsrosa/thermaltake-6inch-lcd-linux (MIT).
  Thermalright / ChiZhu panel    USB bulk 87ad:70db, "USBLCDNew" protocol.
                                 One PID covers dozens of coolers, so the
                                 geometry is probed from the handshake.

Backgrounds are found exactly the way `omarchy theme bg next` finds them, so
the panels follow the active theme.  Both panels drop back to their own screen
when frames stop arriving, so the current picture is re-sent every keepalive
tick; a new one is picked every `interval` seconds and whenever the theme
changes.  SIGUSR1 advances to the next picture immediately.
"""

__version__ = "1.0"

import argparse
import glob
import io
import json
import os
import random
import select
import signal
import subprocess
import threading
import sys
import time

STATE = os.path.expanduser("~/.local/state/omarchy/current")
CONFIG = os.path.expanduser("~/.config/omarchy/lcd-bg.json")
# Per-machine overrides, merged over CONFIG and never versioned.  How a panel
# is physically mounted - which way up it sits in the case - cannot be probed
# and differs between machines sharing these dotfiles, so it belongs here
# rather than in the file stow links into the repo.
LOCAL_CONFIG = os.path.expanduser("~/.config/omarchy/lcd-bg.local.json")
IMAGE_EXTS = (".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp")

DEFAULTS = {
    "interval": 300,        # seconds a picture stays up
    "keepalive": 2.0,       # re-send period; panels time out after ~5s
    "quality": 88,          # JPEG quality
    "shuffle": True,        # random order vs. sorted order
    "avoid_desktop_background": True,   # skip whatever the desktop is wearing
    "thermaltake": {"enabled": True, "brightness": 100, "rotate": 0,
                    "stats": False, "stats_font": None,
                    "video": None, "video_fps": 30, "video_quality": 6,
                    "video_loop": True},
    "thermalright": {"enabled": True, "resolution": None, "circle": False,
                     "rotate": 0, "stats": False, "stats_font": None,
                     "video": None, "video_fps": 30, "video_quality": 6,
                     "video_loop": True},
}


def load_config():
    """DEFAULTS, then the versioned config, then this machine's overrides."""
    cfg = {k: (dict(v) if isinstance(v, dict) else v) for k, v in DEFAULTS.items()}
    for path in (CONFIG, LOCAL_CONFIG):
        try:
            with open(path) as fh:
                layer = json.load(fh)
        except FileNotFoundError:
            continue
        except (OSError, ValueError) as e:
            log(f"config {path}: {e}; ignoring it")
            continue
        for key, value in layer.items():
            if isinstance(cfg.get(key), dict) and isinstance(value, dict):
                cfg[key].update(value)
            else:
                cfg[key] = value
    return cfg


def log(msg):
    print(f"omarchy-lcd-bg: {msg}", file=sys.stderr, flush=True)


# -- backgrounds ------------------------------------------------------------
def theme_name():
    try:
        with open(os.path.join(STATE, "theme.name")) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def desktop_background():
    """The image the desktop itself is wearing, or None.

    Omarchy points ~/.local/state/omarchy/current/background at the live
    wallpaper and repoints it on `omarchy theme bg next`."""
    try:
        return os.path.realpath(os.path.join(STATE, "background"))
    except OSError:
        return None


def backgrounds(exclude=None):
    """Every background for the active theme, the way omarchy-theme-bg-next
    enumerates them: the user's additions first, then the theme's own.

    `exclude` drops one image - the desktop's own wallpaper - so the panels
    show something the monitor isn't already showing.  If that would leave
    nothing, the exclusion is dropped: a theme with a single background is
    better served by duplicating it than by going dark."""
    name = theme_name()
    found = []
    for directory in (os.path.expanduser(f"~/.config/omarchy/backgrounds/{name}"),
                      os.path.join(STATE, "theme", "backgrounds")):
        try:
            entries = sorted(os.listdir(directory))
        except OSError:
            continue
        for entry in entries:
            path = os.path.join(directory, entry)
            if entry.lower().endswith(IMAGE_EXTS) and os.path.isfile(path):
                found.append(path)
    if exclude:
        kept = [p for p in found if os.path.realpath(p) != exclude]
        if kept:
            return kept
        if found:
            log("the desktop wallpaper is the only background for this theme; "
                "showing it anyway")
    return found


# -- image preparation ------------------------------------------------------
# -- sensors ----------------------------------------------------------------
class Telemetry:
    """CPU and GPU temperature and utilisation.

    Every reading is best-effort: a missing sensor yields None and the panel
    draws a dash rather than the daemon failing. Readings are cached for
    `interval` seconds because nvidia-smi is a process spawn, not a file read."""

    def __init__(self, interval=2.0):
        self.interval = interval
        self._at = 0.0
        self._cache = {}
        self._cpu_prev = self._read_proc_stat()

    # CPU temperature: k10temp's Tctl. hwmon numbering is not stable across
    # boots, so the sensor is found by driver name, never by hwmonN.
    @staticmethod
    def _cpu_temp():
        for d in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
            try:
                if open(os.path.join(d, "name")).read().strip() != "k10temp":
                    continue
                for probe in glob.glob(os.path.join(d, "temp*_input")):
                    label = probe.replace("_input", "_label")
                    try:
                        if open(label).read().strip() == "Tctl":
                            return int(open(probe).read()) / 1000.0
                    except OSError:
                        continue
                first = sorted(glob.glob(os.path.join(d, "temp*_input")))
                if first:
                    return int(open(first[0]).read()) / 1000.0
            except (OSError, ValueError):
                continue
        return None

    @staticmethod
    def _read_proc_stat():
        try:
            with open("/proc/stat") as fh:
                parts = [int(v) for v in fh.readline().split()[1:]]
        except (OSError, ValueError, IndexError):
            return None
        if len(parts) < 5:
            return None
        idle = parts[3] + parts[4]          # idle + iowait
        return sum(parts), idle

    def _cpu_use(self):
        now = self._read_proc_stat()
        if now is None or self._cpu_prev is None:
            self._cpu_prev = now
            return None
        total_d = now[0] - self._cpu_prev[0]
        idle_d = now[1] - self._cpu_prev[1]
        self._cpu_prev = now
        if total_d <= 0:
            return None
        return max(0.0, min(100.0, 100.0 * (total_d - idle_d) / total_d))

    @staticmethod
    def _gpu():
        """Temperature and utilisation of the discrete NVIDIA GPU.

        nvidia-smi rather than hwmon: the amdgpu hwmon on this board is the
        CPU's integrated graphics, not the card driving the display."""
        try:
            out = subprocess.run(
                ["nvidia-smi", "--query-gpu=temperature.gpu,utilization.gpu",
                 "--format=csv,noheader,nounits"],
                capture_output=True, text=True, timeout=4)
        except (OSError, subprocess.SubprocessError):
            return None, None
        if out.returncode != 0 or not out.stdout.strip():
            return None, None
        try:
            temp, use = out.stdout.strip().splitlines()[0].split(",")
            return float(temp), float(use)
        except (ValueError, IndexError):
            return None, None

    def read(self):
        now = time.monotonic()
        if self._cache and (now - self._at) < self.interval:
            return self._cache
        gpu_temp, gpu_use = self._gpu()
        self._cache = {"cpu_temp": self._cpu_temp(), "cpu_use": self._cpu_use(),
                       "gpu_temp": gpu_temp, "gpu_use": gpu_use}
        self._at = now
        return self._cache


# -- image preparation ------------------------------------------------------
# Fallbacks, tried in order, when no font is configured or the configured one
# cannot be loaded. Adwaita Sans is a variable font, so a weight far heavier
# than Bold is available for the big readout.
FONT_FALLBACKS = (
    ("/usr/share/fonts/Adwaita/AdwaitaSans-Regular.ttf", "Black"),
    ("/usr/share/fonts/noto/NotoSans-Bold.ttf", None),
    ("/usr/share/fonts/liberation/LiberationSans-Bold.ttf", None),
    ("/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Bold.ttf", None),
)
_FONTS = {}
_FC_CACHE = {}


def resolve_font(spec):
    """Turn a config value into a font file path.

    Accepts a path, or a fontconfig pattern such as "Adwaita Sans" or
    "Noto Sans:style=Bold" - fc-match always answers with *something*, so the
    result is only trusted when the family actually matches what was asked."""
    if not spec:
        return None
    if os.path.sep in spec and os.path.isfile(spec):
        return spec
    if spec in _FC_CACHE:
        return _FC_CACHE[spec]
    path = None
    try:
        out = subprocess.run(["fc-match", "-f", "%{file}\t%{family[0]}", spec],
                             capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            path, _, matched = out.stdout.strip().partition("\t")
            # fc-match substitutes its best guess rather than failing, so a
            # misspelt family yields a real file for a different typeface.
            # Say so instead of quietly rendering in something else.
            wanted = spec.split(":")[0].strip()
            if wanted and matched and wanted.lower() != matched.strip().lower():
                log(f"font {spec!r} not installed; fontconfig substituted "
                    f"{matched.strip()!r}")
    except (OSError, subprocess.SubprocessError):
        path = None
    _FC_CACHE[spec] = path
    return path


def font(size, spec=None, weight=None):
    """A face at `size`, cached - loading a TTF per frame is wasteful.

    `spec` is a font path or fontconfig pattern; `weight` names a named
    instance of a variable font (Bold, ExtraBold, Black, ...) and is ignored
    by fonts that do not carry one."""
    key = (spec, weight, size)
    if key in _FONTS:
        return _FONTS[key]
    from PIL import ImageFont

    attempts = []
    if spec:
        resolved = resolve_font(spec)
        if resolved:
            attempts.append((resolved, weight))
    attempts.extend((path, weight or default_weight)
                    for path, default_weight in FONT_FALLBACKS)

    chosen = None
    for path, want in attempts:
        try:
            face = ImageFont.truetype(path, size)
        except OSError:
            continue
        if want:
            try:
                face.set_variation_by_name(want)
            except Exception:
                pass        # not a variable font, or no such named instance
        chosen = face
        break
    _FONTS[key] = chosen or ImageFont.load_default()
    return _FONTS[key]


def fit_background(path, canvas):
    """Open an image and return it as RGB of exactly `canvas`, in the
    orientation the viewer sees - any panel rotation is applied later, by
    encode(), so that anything drawn on top comes out the right way up.

    Wallpapers rarely share the panel's aspect ratio, so the image is scaled
    to cover and centre-cropped: letterboxing a 2:1 panel wastes most of it."""
    from PIL import Image

    img = Image.open(path)
    img.draft("RGB", canvas)        # let the JPEG decoder downscale while reading
    img = img.convert("RGB")

    target_w, target_h = canvas
    scale = max(target_w / img.width, target_h / img.height)
    scaled = (max(target_w, round(img.width * scale)),
              max(target_h, round(img.height * scale)))
    img = img.resize(scaled, Image.LANCZOS)
    left = (img.width - target_w) // 2
    top = (img.height - target_h) // 2
    return img.crop((left, top, left + target_w, top + target_h))


def encode(img, rotate=0, circle=False, quality=88):
    """Mask, rotate into panel orientation, and return baseline JPEG bytes."""
    from PIL import Image, ImageDraw

    if circle:
        w, h = img.size
        mask = Image.new("L", img.size, 0)
        ImageDraw.Draw(mask).ellipse((0, 0, w - 1, h - 1), fill=255)
        backdrop = Image.new("RGB", img.size, (0, 0, 0))
        backdrop.paste(img, (0, 0), mask)
        img = backdrop
    if rotate % 360:
        img = img.rotate(-rotate, expand=True)

    buf = io.BytesIO()
    img.save(buf, "JPEG", quality=quality, progressive=False)
    return buf.getvalue()


def _fmt(value, suffix):
    return "--" if value is None else "%d%s" % (round(value), suffix)


def _mean_luma(img, box):
    """Perceived brightness, 0-255, of a region - sampled from a thumbnail
    rather than every pixel, since only the rough level matters."""
    from PIL import Image

    left, top, right, bottom = (int(v) for v in box)
    left, top = max(0, left), max(0, top)
    right, bottom = min(img.width, right), min(img.height, bottom)
    if right <= left or bottom <= top:
        return 128.0
    patch = img.crop((left, top, right, bottom)).convert("L")
    return float(patch.resize((1, 1), Image.BILINEAR).getpixel((0, 0)))


def _palette(luma, accent):
    """Text, stroke, bar-track and accent colours legible over `luma`.

    A fixed light-on-dark scheme fails on a pale wallpaper, where the gradient
    never gets dark enough to carry white text; inverting to dark-on-light is
    the only thing that reliably holds contrast across arbitrary pictures."""
    if luma >= 145:                                   # pale background
        return ((18, 18, 24, 255), (255, 255, 255, 205),
                (0, 0, 0, 70), tuple(int(c * 0.40) for c in accent))
    return ((255, 255, 255, 250), (0, 0, 0, 175),
            (255, 255, 255, 50), accent)


# Overlay text sizes, as a fraction of the panel's height so one setting
# holds across panels of different resolutions. Overridable per panel through
# "stats_font" in the config.
STATS_FONT = {"family": None, "weight": None,
              "label": 0.105, "value": 0.135, "percent": 0.060}

# Tabular figures keep every digit the same width, so a value ticking from 9
# to 10 does not shove the degree sign sideways twice a second. Needs raqm;
# without it PIL still draws, just proportionally.
try:
    from PIL import features as _pil_features
    _TNUM = ["tnum"] if _pil_features.check("raqm") else None
except Exception:
    _TNUM = None


def draw_stats(img, data, sizes=None):
    """Overlay CPU and GPU temperature and load along the bottom.

    The band's height is derived from the font sizes rather than fixed, so
    enlarging the text in the config grows the backdrop with it instead of
    pushing the readout off the panel.

    Returns a new image; the caller keeps the clean background to
    re-composite against on the next tick."""
    from PIL import Image, ImageDraw

    sizes = {**STATS_FONT, **(sizes or {})}
    w, h = img.size

    family, weight = sizes.get("family"), sizes.get("weight")
    f_label = font(max(10, int(h * float(sizes["label"]))), family, weight)
    f_value = font(max(14, int(h * float(sizes["value"]))), family, weight)
    f_pct = font(max(8, int(h * float(sizes["percent"]))), family, weight)
    px_label = f_label.size if hasattr(f_label, "size") else int(h * 0.105)
    px_value = f_value.size if hasattr(f_value, "size") else int(h * 0.135)

    pad = int(w * 0.035)
    margin = int(h * 0.035)
    lead = int(h * 0.015)
    bar_h = max(5, int(h * 0.022))

    # Lay the rows out from the bottom edge up, then let the band cover them.
    bar_y = h - margin - bar_h
    y_temp = bar_y - int(h * 0.028)                       # baseline
    y_label = y_temp - int(px_value * 0.80) - lead        # baseline
    band = min(h, max(int(h * 0.26), h - (y_label - int(px_label * 0.80)) + margin))
    top = h - band

    # A gradient rather than a flat strip: a hard edge across a wallpaper reads
    # as damage, while a fade looks like part of the picture. Shade first and
    # composite, so the text can be coloured against what it will really sit
    # on - the gradient is part of that background, not separate from it.
    shade = Image.new("RGBA", img.size, (0, 0, 0, 0))
    ramp = (Image.linear_gradient("L")
            .resize((w, band), Image.BILINEAR)
            .point(lambda v: int(224 * (v / 255.0) ** 1.6)))
    shade.paste((0, 0, 0, 255), (0, top, w, h), ramp)
    shaded = Image.alpha_composite(img.convert("RGBA"), shade)

    layer = Image.new("RGBA", img.size, (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)
    stroke = max(1, h // 400)

    half = w // 2
    for index, (name, temp, use, accent) in enumerate((
            ("CPU", data.get("cpu_temp"), data.get("cpu_use"), (125, 200, 255)),
            ("GPU", data.get("gpu_temp"), data.get("gpu_use"), (140, 240, 170)))):
        x = index * half
        # Measure where the heading and temperature actually land, not the
        # whole half: the far end of the bar often sits on quite different
        # pixels, and it is the text that has to stay readable.
        luma = _mean_luma(shaded, (x + pad, y_label - px_label,
                                   x + pad + int(half * 0.55), y_temp))
        text_fill, stroke_fill, track_fill, accent = _palette(luma, accent)

        d.text((x + pad, y_label), name, font=f_label, fill=accent + (245,),
               anchor="ls", stroke_width=stroke, stroke_fill=stroke_fill)
        d.text((x + pad, y_temp), _fmt(temp, "\u00b0C"), font=f_value,
               fill=text_fill, anchor="ls", features=_TNUM,
               stroke_width=stroke + 1, stroke_fill=stroke_fill)

        # The percentage is right-aligned to the half it belongs to and the
        # bar stops short of it, so the bar changes length with the digits
        # instead of the text drifting over it at 100%.
        pct = _fmt(use, "%")
        pct_w = d.textlength(pct, font=f_pct, features=_TNUM)
        d.text((x + half - pad, bar_y + bar_h // 2), pct, font=f_pct,
               fill=text_fill, anchor="rm", features=_TNUM,
               stroke_width=stroke, stroke_fill=stroke_fill)

        bar_x0 = x + pad
        bar_x1 = int(x + half - pad - pct_w - w * 0.016)
        if bar_x1 > bar_x0 + bar_h:
            d.rounded_rectangle([bar_x0, bar_y, bar_x1, bar_y + bar_h],
                                radius=bar_h // 2, fill=track_fill)
            if use is not None:
                span = bar_x1 - bar_x0
                filled = bar_x0 + int(span * max(0.0, min(100.0, use)) / 100.0)
                if filled > bar_x0 + bar_h:
                    d.rounded_rectangle([bar_x0, bar_y, filled, bar_y + bar_h],
                                        radius=bar_h // 2, fill=accent + (235,))

    return Image.alpha_composite(shaded, layer).convert("RGB")


def test_pattern(size, label, rotate=0):
    """Corner-marked image: makes orientation, cropping and scale obvious.

    Drawn the same way a wallpaper is, so the pattern exercises the panel's
    configured rotation rather than bypassing it: a quarter turn is drawn on a
    swapped canvas first, so the result is always exactly `size`."""
    from PIL import Image, ImageDraw

    rotate %= 360
    canvas = (size[1], size[0]) if rotate in (90, 270) else size
    w, h = canvas
    img = Image.new("RGB", canvas, "#101010")
    d = ImageDraw.Draw(img)
    d.rectangle([0, 0, w - 1, h - 1], outline="#00ff88", width=max(2, h // 60))
    box = max(24, min(w, h) // 6)
    for (x, y), colour, name in (
        ((0, 0), "#ff3333", "TL"), ((w - box, 0), "#33ff33", "TR"),
        ((0, h - box), "#3333ff", "BL"), ((w - box, h - box), "#ffff33", "BR"),
    ):
        inset = box // 8
        d.rectangle([x + inset, y + inset, x + box - inset, y + box - inset],
                    fill=colour)
        d.text((x + box // 2, y + box // 2), name, fill="#000000", anchor="mm")
    d.text((w // 2, h // 2), f"{label}\n{size[0]}x{size[1]}", fill="#ffffff",
           anchor="mm", align="center")
    if rotate:
        img = img.rotate(-rotate, expand=True)

    buf = io.BytesIO()
    img.save(buf, "JPEG", quality=92, progressive=False)
    return buf.getvalue()


# -- Thermaltake 6" panel (USB HID 264a:2347) -------------------------------
class Thermaltake:
    """The 'BY' protocol: HTTP-like text commands and JPEG frames, each in one
    1024-byte HID report.

    Every report is framed `5A | len_be16 | payload | sum8 | 5A`, where `len`
    counts the whole unescaped frame and `sum8` is the sum of the length bytes
    and payload mod 256.  Between the two `5A` delimiters, `5A` is escaped to
    `5B 01` and `5B` to `5B 02`.  usbhid strips a leading report-number byte
    from devices with no numbered reports, so each report goes out as
    `00` + 1024 bytes."""

    VID, PID = 0x264A, 0x2347
    NAME = "Thermaltake 6\" panel"
    SIZE = (1110, 540)
    PACKET = 1024
    HEADER = 24
    CHUNK = PACKET - HEADER
    MAX_JPEG = 0xC7FFF          # TT RGB Plus refuses anything larger
    SEQ = 112

    def __init__(self, config):
        self.config = config
        self.fd = None
        self.counter = 0
        rotate = int(config.get("rotate", 0)) % 360
        self.size = self.SIZE[::-1] if rotate in (90, 270) else self.SIZE
        self.circle = False
        self.rotate_image = 0   # the panel rotates in firmware

    # framing
    @staticmethod
    def _frame(payload):
        total = len(payload) + 5
        body = bytes((total >> 8, total & 0xFF)) + payload
        body += bytes((sum(body) & 0xFF,))
        body = body.replace(b"\x5b", b"\x5b\x02").replace(b"\x5a", b"\x5b\x01")
        return b"\x5a" + body + b"\x5a"

    @staticmethod
    def _unframe(data):
        start = data.index(0x5A)
        end = data.index(0x5A, start + 1)
        body = (data[start + 1:end]
                .replace(b"\x5b\x01", b"\x5a")
                .replace(b"\x5b\x02", b"\x5b"))
        if (sum(body[:-1]) & 0xFF) != body[-1]:
            raise ValueError("reply checksum mismatch")
        return body[2:-1]

    @classmethod
    def _message(cls, verb, body=""):
        return (f"{verb}\r\nSeqNumber={cls.SEQ}\r\nContentType=json\r\n"
                f"ContentLength={len(body)}\r\n\r\n{body}").encode()

    @classmethod
    def node(cls):
        for path in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
            try:
                with open(os.path.join(path, "device", "uevent")) as fh:
                    text = fh.read()
            except OSError:
                continue
            if f"{cls.VID:08X}:{cls.PID:08X}" in text.upper():
                return "/dev/" + os.path.basename(path)
        return None

    def _write(self, report):
        os.write(self.fd, b"\x00" + report.ljust(self.PACKET, b"\x00"))

    def command(self, verb, body="", timeout=3.0):
        self._write(self._frame(self._message(verb, body)))
        ready, _, _ = select.select([self.fd], [], [], timeout)
        if not ready:
            raise TimeoutError(f"no reply to {verb!r}")
        payload = self._unframe(os.read(self.fd, self.PACKET + 1))
        text = payload.decode(errors="replace")
        head, _, body_text = text.partition("\r\n\r\n")
        status = head.split("\r\n", 1)[0]
        if not status.endswith(" 200"):
            raise RuntimeError(f"{verb!r} failed: {status}")
        return json.loads(body_text) if body_text.strip() else None

    def open(self):
        node = self.node()
        if not node:
            raise FileNotFoundError(
                f"no hidraw node for {self.VID:04x}:{self.PID:04x}")
        if not os.access(node, os.W_OK):
            raise PermissionError(f"{node} is not writable - is the udev rule installed?")
        self.fd = os.open(node, os.O_RDWR)
        try:
            info = self.command("POST conn 1")
            rotate = int(self.config.get("rotate", 0)) % 360
            if rotate:
                self.command("POST rotate 1", json.dumps({"degree": rotate}))
            brightness = self.config.get("brightness")
            if brightness is not None:
                self.command("POST brightness 1",
                             json.dumps({"value": max(0, min(100, int(brightness)))}))
            self.command("POST realtimeDisplay 1", json.dumps({"enable": True}))
        except Exception:
            self.close()
            raise
        return info

    def send(self, jpeg):
        if not 0 < len(jpeg) <= self.MAX_JPEG:
            raise ValueError(f"JPEG is {len(jpeg)} bytes, limit {self.MAX_JPEG}")
        total = -(-len(jpeg) // self.CHUNK)
        for index in range(total):
            head = bytes((0x5C, 0x03, 0xFD, self.counter,
                          total >> 8, total & 0xFF,
                          index >> 8, index & 0xFF, 0x01))
            piece = jpeg[index * self.CHUNK:(index + 1) * self.CHUNK]
            self._write(head.ljust(self.HEADER, b"\x00") + piece)
        self.counter = (self.counter + 1) % 60

    def close(self):
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None


# -- Thermalright / ChiZhu panel (USB bulk 87ad:70db) -----------------------
# One PID covers dozens of coolers at different resolutions, so the geometry
# comes from the handshake.  Tables ported from Lexonight1/thermalright-trcc-
# linux (its FBL catalogue); PM=4 is absent there but is 480x480 in practice,
# per lFiziXl/retro-aio-thermalright-hypervision-360.
_PM_TO_FBL = {
    4: 72, 5: 50, 7: 64, 9: 224, 10: 224, 11: 224, 12: 224, 13: 224, 14: 64,
    15: 224, 16: 224, 17: 224, 18: 224, 20: 224, 32: 100, 50: 50, 63: 114,
    64: 114, 65: 192, 66: 192, 68: 192, 69: 192,
}
_PM_SUB_TO_FBL = {(1, 48): 114, (1, 49): 192}
_FBL_192_BY_PM = {1: (1920, 462), 65: (1920, 462), 66: (1920, 462),
                  68: (1280, 480), 69: (1920, 440)}
_FBL_224_BY_PM = {9: (854, 480), 10: (960, 540), 11: (854, 480), 12: (800, 480),
                  13: (960, 320), 15: (640, 172), 16: (960, 540), 17: (960, 320),
                  18: (960, 320), 20: (854, 480)}
_FBL_RESOLUTION = {
    36: (240, 240), 37: (240, 240), 50: (320, 240), 51: (320, 240),
    52: (320, 240), 53: (320, 240), 54: (360, 360), 58: (320, 240),
    59: (640, 172), 60: (320, 176), 64: (640, 480), 72: (480, 480),
    100: (320, 320), 101: (320, 320), 102: (320, 320), 114: (1600, 720),
    128: (1280, 480), 129: (480, 480), 192: (1920, 462), 224: (854, 480),
}


def resolve_geometry(pm, sub):
    """Map the handshake's PM/SUB bytes to (width, height, fbl)."""
    fbl = _PM_SUB_TO_FBL.get((pm, sub)) or _PM_TO_FBL.get(pm, pm)
    if fbl == 192:
        size = _FBL_192_BY_PM.get(pm, (1920, 462))
    elif fbl == 224:
        size = _FBL_224_BY_PM.get(pm, (854, 480))
    else:
        size = _FBL_RESOLUTION.get(fbl)
    if size is None:
        return None, None, fbl
    return size[0], size[1], fbl


class Thermalright:
    """The 'USBLCDNew' protocol: a 64-byte header plus a JPEG, written to the
    bulk OUT endpoint.

    Header (little-endian): magic 0x12345678 at [0:4], command at [4:8]
    (2 = JPEG, 3 = raw RGB565), width at [8:12], height at [12:16], the
    constant 2 at [56:60] and the payload length at [60:64].  The firmware
    de-blocks the JPEG using the header's geometry, so the JPEG must be
    exactly the declared size."""

    VID, PID = 0x87AD, 0x70DB
    NAME = "Thermalright panel"
    MAGIC = b"\x12\x34\x56\x78"
    CMD_INFO = 0x01
    CMD_JPEG = 2
    CMD_RGB565 = 3
    WRITE_CHUNK = 16 * 1024
    ZLP_ALIGN = 512

    def __init__(self, config):
        self.config = config
        self.dev = None
        self.ep_out = self.ep_in = None
        self.pm = self.sub = self.fbl = None
        self.size = None
        self.circle = bool(config.get("circle", False))
        self.rotate_image = int(config.get("rotate", 0)) % 360

    def open(self):
        import usb.core
        import usb.util

        dev = usb.core.find(idVendor=self.VID, idProduct=self.PID)
        if dev is None:
            raise FileNotFoundError(f"no USB device {self.VID:04x}:{self.PID:04x}")

        # The firmware can present vendor, HID and mass-storage interfaces; a
        # kernel driver on any sibling blocks claiming the bulk endpoints.
        for number in range(4):
            try:
                if dev.is_kernel_driver_active(number):
                    dev.detach_kernel_driver(number)
            except (usb.core.USBError, NotImplementedError):
                pass
        try:
            cfg = dev.get_active_configuration()
        except usb.core.USBError:
            dev.set_configuration()
            cfg = dev.get_active_configuration()

        interface = cfg[(0, 0)]
        for endpoint in interface:
            if usb.util.endpoint_type(endpoint.bmAttributes) != usb.util.ENDPOINT_TYPE_BULK:
                continue
            direction = usb.util.endpoint_direction(endpoint.bEndpointAddress)
            if direction == usb.util.ENDPOINT_OUT and self.ep_out is None:
                self.ep_out = endpoint.bEndpointAddress
            elif direction == usb.util.ENDPOINT_IN and self.ep_in is None:
                self.ep_in = endpoint.bEndpointAddress
        if self.ep_out is None or self.ep_in is None:
            self.ep_out, self.ep_in = 0x01, 0x81
        usb.util.claim_interface(dev, 0)
        self.dev = dev

        try:
            self._handshake()
        except Exception:
            self.close()
            raise
        return {"pm": self.pm, "sub": self.sub, "fbl": self.fbl,
                "resolution": self.size}

    def _handshake(self):
        request = bytearray(64)
        request[0:4] = self.MAGIC
        request[56] = self.CMD_INFO
        self.dev.write(self.ep_out, bytes(request), 1000)
        response = self.dev.read(self.ep_in, 1024, 1000)
        if len(response) < 41 or response[24] == 0:
            raise RuntimeError(
                f"handshake failed (response {len(response)} bytes, "
                f"PM={response[24] if len(response) > 24 else None})")
        self.pm, self.sub = response[24], response[36]

        override = self.config.get("resolution")
        if override:
            width, height = (int(v) for v in str(override).lower().split("x"))
            self.fbl = _PM_SUB_TO_FBL.get((self.pm, self.sub)) or \
                _PM_TO_FBL.get(self.pm, self.pm)
            self.size = (width, height)
            return
        width, height, fbl = resolve_geometry(self.pm, self.sub)
        self.fbl = fbl
        if width is None:
            raise RuntimeError(
                f"unknown panel (PM={self.pm} SUB={self.sub} FBL={fbl}); set "
                f'"resolution": "WxH" under "thermalright" in {LOCAL_CONFIG}')
        self.size = (width, height)

    def send(self, jpeg):
        if self.pm == 32:
            raise RuntimeError("PM=32 panels take raw RGB565, not JPEG")
        width, height = self.size
        header = bytearray(64)
        header[0:4] = self.MAGIC
        header[4:8] = self.CMD_JPEG.to_bytes(4, "little")
        header[8:12] = width.to_bytes(4, "little")
        header[12:16] = height.to_bytes(4, "little")
        header[56:60] = (2).to_bytes(4, "little")
        header[60:64] = len(jpeg).to_bytes(4, "little")
        frame = bytes(header) + jpeg

        for offset in range(0, len(frame), self.WRITE_CHUNK):
            chunk = frame[offset:offset + self.WRITE_CHUNK]
            wrote = self.dev.write(self.ep_out, chunk, 5000)
            if wrote < len(chunk):
                raise IOError(f"short write at {offset}: {wrote}/{len(chunk)}")
        if len(frame) % self.ZLP_ALIGN == 0:
            self.dev.write(self.ep_out, b"", 5000)

    def close(self):
        if self.dev is not None:
            try:
                import usb.util
                usb.util.release_interface(self.dev, 0)
                usb.util.dispose_resources(self.dev)
            except Exception:
                pass
            self.dev = None


# -- video ------------------------------------------------------------------
def _rotate_filter(rotate):
    """ffmpeg filter that puts a frame into panel orientation."""
    return {90: "transpose=1", 180: "hflip,vflip",
            270: "transpose=2"}.get(rotate % 360)


def mjpeg_frames(stream, chunk=1 << 16):
    """Split a concatenated-JPEG stream into frames.

    Scanning for the EOI marker is safe here: inside entropy-coded data a
    literal 0xFF is byte-stuffed as FF 00, and restart markers only go up to
    FF D7, so FF D9 cannot occur except as a real end-of-image."""
    buf = b""
    while True:
        data = stream.read(chunk)
        if not data:
            return
        buf += data
        while True:
            start = buf.find(b"\xff\xd8")
            if start < 0:
                buf = buf[-1:]          # a split FF would otherwise be lost
                break
            end = buf.find(b"\xff\xd9", start + 2)
            if end < 0:
                buf = buf[start:]
                break
            yield buf[start:end + 2]
            buf = buf[end + 2:]


class VideoPlayer(threading.Thread):
    """Plays a video file to one panel, in its own thread.

    ffmpeg does the decode, scale, crop, rotate and JPEG encode, so the only
    work here is splitting frames and writing them - the panel wants JPEG,
    which is exactly what an MJPEG stream already is."""

    RETRY = 15.0

    def __init__(self, screen, path, fps=30, quality=6, loop=True):
        super().__init__(daemon=True, name=f"video:{screen.name}")
        self.screen = screen
        self.path = os.path.expanduser(path)
        self.fps = max(1, int(fps))
        self.quality = max(2, min(31, int(quality)))
        self.loop = loop
        self._stop = threading.Event()
        self._proc = None

    def stop(self):
        self._stop.set()
        proc, self._proc = self._proc, None
        if proc and proc.poll() is None:
            proc.terminate()

    def _command(self):
        driver = self.screen.driver
        rotate = driver.rotate_image % 360
        w, h = driver.size
        cw, ch = (h, w) if rotate in (90, 270) else (w, h)
        chain = [f"scale={cw}:{ch}:force_original_aspect_ratio=increase",
                 f"crop={cw}:{ch}", f"fps={self.fps}"]
        spin = _rotate_filter(rotate)
        if spin:
            chain.append(spin)
        # -re makes ffmpeg emit at the stream's own rate. Without it the
        # decode runs flat out: these frames compress small enough that the
        # panel is not the bottleneck either, and the video plays at several
        # times speed.
        return ["ffmpeg", "-nostdin", "-loglevel", "error",
                "-re", "-i", self.path, "-an", "-vf", ",".join(chain),
                "-q:v", str(self.quality), "-f", "mjpeg", "-"]

    def run(self):
        while not self._stop.is_set():
            if not self.screen.ready:
                self.screen.next_try = 0.0
                self.screen.connect(time.monotonic())
                if not self.screen.ready:
                    self._stop.wait(self.RETRY)
                    continue
            if not self._play_once():
                return
            if not self.loop:
                return

    def _play_once(self):
        """One pass over the file. False means stop trying."""
        try:
            proc = subprocess.Popen(self._command(), stdout=subprocess.PIPE,
                                    stderr=subprocess.PIPE, bufsize=0)
        except OSError as e:
            log(f"{self.screen.name}: cannot start ffmpeg ({e})")
            return False
        self._proc = proc

        # ffmpeg sets the pace via -re; a wall-clock check backs it up, so a
        # frame the panel could not keep up with is dropped rather than
        # letting playback slide permanently behind the soundtrack.
        shown = dropped = 0
        period = 1.0 / self.fps
        # Timed from the first frame, not from the spawn: ffmpeg takes a
        # moment to start producing, and counting that as lag would make the
        # guard drop every frame for the whole file.
        started = None
        # Only a visible slip matters; per-frame jitter is normal and -re is
        # already doing the pacing.
        slack = max(0.5, period * 4)
        try:
            for index, frame in enumerate(mjpeg_frames(proc.stdout)):
                if self._stop.is_set():
                    break
                now = time.monotonic()
                if started is None:
                    started = now
                if (now - started) - index * period > slack:
                    dropped += 1
                    continue
                try:
                    self.screen.driver.send(frame)
                except Exception as e:
                    log(f"{self.screen.name}: lost during playback ({e})")
                    self.screen.driver.close()
                    self.screen.ready = False
                    break
                shown += 1
        finally:
            if proc.poll() is None:
                proc.terminate()
            err = b""
            try:
                err = proc.stderr.read() or b""
            except Exception:
                pass
            proc.wait()
            self._proc = None

        if shown == 0:
            detail = err.decode(errors="replace").strip().splitlines()
            log(f"{self.screen.name}: no frames from {os.path.basename(self.path)}"
                + (f" - {detail[-1]}" if detail else ""))
            return False
        elapsed = max(1e-6, time.monotonic() - (started or time.monotonic()))
        log(f"{self.screen.name}: played {shown} frames "
            f"({shown / elapsed:.1f} fps)"
            + (f", dropped {dropped}" if dropped else ""))
        return True


# -- panel supervision ------------------------------------------------------
class Screen:
    """One panel plus the state needed to keep it alive across unplugs."""

    RETRY = 15.0            # seconds between reconnect attempts

    def __init__(self, driver, telemetry=None):
        self.driver = driver
        self.telemetry = telemetry      # set only on panels showing stats
        self.ready = False
        self.next_try = 0.0
        self.base = None                # fitted background, viewer orientation
        self.frame = None               # encoded JPEG, panel orientation
        self.source = None

    @property
    def name(self):
        return self.driver.NAME

    @property
    def canvas(self):
        """Panel size in the orientation the viewer sees it."""
        w, h = self.driver.size
        return (h, w) if self.driver.rotate_image % 360 in (90, 270) else (w, h)

    @property
    def live(self):
        """True when the frame has to be rebuilt on every tick."""
        return self.telemetry is not None

    def connect(self, now):
        if self.ready or now < self.next_try:
            return
        self.next_try = now + self.RETRY
        try:
            info = self.driver.open()
        except Exception as e:
            log(f"{self.name}: {e}")
            return
        self.ready = True
        self.frame = None
        self.base = None
        size = "x".join(str(v) for v in self.driver.size)
        extra = ""
        if isinstance(info, dict) and "pm" in info:
            extra = f" (PM={info['pm']} SUB={info['sub']} FBL={info['fbl']})"
        log(f"{self.name}: connected, {size}{extra}")

    def show(self, path, quality):
        """Make `path` this panel's picture and put it up."""
        if not self.ready:
            return
        try:
            self.base = fit_background(path, self.canvas)
            self.source = path
        except Exception as e:
            log(f"{self.name}: cannot render {os.path.basename(path)}: {e}")
            self.base = self.frame = None
            return
        self.compose(quality)
        self.push()

    def compose(self, quality):
        """Build the JPEG from the cached background plus any live overlay.

        The background is kept decoded and already fitted, so a stats panel
        re-draws and re-encodes each tick without touching the file again."""
        if self.base is None:
            return
        try:
            img = self.base
            if self.telemetry is not None:
                img = draw_stats(img, self.telemetry.read(),
                                 self.driver.config.get("stats_font"))
            self.frame = encode(img, rotate=self.driver.rotate_image,
                                circle=self.driver.circle, quality=quality)
        except Exception as e:
            log(f"{self.name}: cannot compose frame: {e}")

    def push(self):
        if not self.ready or self.frame is None:
            return
        try:
            self.driver.send(self.frame)
        except Exception as e:
            log(f"{self.name}: lost ({e}); will retry")
            self.driver.close()
            self.ready = False
            self.next_try = time.monotonic() + self.RETRY

    def close(self):
        if self.ready:
            self.driver.close()
        self.ready = False


_TELEMETRY = []


def shared_telemetry():
    """One Telemetry for every panel that wants it - the CPU-usage delta is
    stateful, and two independent readers would halve each other's sample."""
    if not _TELEMETRY:
        _TELEMETRY.append(Telemetry())
    return _TELEMETRY[0]


def build_screens(config, only=None):
    screens = []
    for key, driver_class in (("thermaltake", Thermaltake),
                              ("thermalright", Thermalright)):
        section = config.get(key, {})
        if not section.get("enabled", True):
            continue
        if only and key != only:
            continue
        telemetry = shared_telemetry() if section.get("stats") else None
        screens.append(Screen(driver_class(section), telemetry))
    return screens


# -- main -------------------------------------------------------------------
class Playlist:
    """The pool of pictures the panels draw from.

    Hands a *different* picture to each panel: one panel never shows what
    another is already showing, and prefers not to repeat what it was just
    showing.  With fewer pictures than panels duplication is unavoidable, so
    the preference is dropped before a panel is left blank."""

    def __init__(self, shuffle=True):
        self.shuffle = shuffle
        self.queue = []
        self.wallpaper = None

    def reset(self, wallpaper):
        """Forget the queue - the theme or the desktop wallpaper moved."""
        self.wallpaper = wallpaper
        self.queue = []

    def _refill(self):
        self.queue = backgrounds(exclude=self.wallpaper)
        if self.shuffle:
            random.shuffle(self.queue)

    def take(self, avoid=(), prefer_not=()):
        """Pop a picture, skipping `avoid` outright and `prefer_not` if it can.

        `avoid` is what the other panels hold right now; `prefer_not` is what
        this panel is already showing.  Honouring `avoid` matters more - two
        panels showing one picture is the thing being fixed here - so it is
        tried on its own once the combined constraint comes up empty."""
        hard = {a for a in avoid if a}
        soft = hard | {a for a in prefer_not if a}
        for pool in (soft, hard):
            for refilled in (False, True):
                for index, path in enumerate(self.queue):
                    if path not in pool:
                        return self.queue.pop(index)
                if not refilled:
                    self._refill()
        if not self.queue:
            self._refill()
        return self.queue.pop(0) if self.queue else None


def run(config, screens):
    """Keep a different random background on each panel until interrupted."""
    advance = {"now": False}

    def on_usr1(_signum, _frame):
        advance["now"] = True

    signal.signal(signal.SIGUSR1, on_usr1)
    stop = {"now": False}
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda *_: stop.__setitem__("now", True))

    interval = float(config["interval"])
    keepalive = float(config["keepalive"])
    quality = int(config["quality"])
    avoid = bool(config["avoid_desktop_background"])

    # A panel with a video configured is handed to its own thread: it needs
    # frames at 30 fps, not the 2 s keepalive tick the wallpaper panels run on.
    players = []
    for screen in list(screens):
        section = screen.driver.config
        path = section.get("video")
        if not path:
            continue
        players.append(VideoPlayer(screen, path,
                                   fps=section.get("video_fps", 30),
                                   quality=section.get("video_quality", 6),
                                   loop=section.get("video_loop", True)))
        screens.remove(screen)
    for player in players:
        log(f"{player.screen.name}: playing {os.path.basename(player.path)} "
            f"at {player.fps} fps")
        player.start()

    playlist = Playlist(bool(config["shuffle"]))
    theme = None
    wallpaper = None
    picked_at = 0.0
    complained = False

    while not stop["now"]:
        now = time.monotonic()

        # A player only exits when the file could not be played, or it was
        # set not to loop. Either way the panel should go back to showing
        # backgrounds rather than sitting dark - which is what a video path
        # that does not exist on this machine would otherwise cause.
        for player in list(players):
            if player.is_alive():
                continue
            players.remove(player)
            screen = player.screen
            screen.base = screen.frame = screen.source = None
            screens.append(screen)
            log(f"{screen.name}: video ended, showing backgrounds")

        for screen in screens:
            screen.connect(now)

        # Both the theme and the desktop's own wallpaper can change under us -
        # `omarchy theme bg next` repoints the background link without touching
        # the theme - so watch each and rebuild the pool when either moves.
        name = theme_name()
        desktop = desktop_background() if avoid else None
        if name != theme:
            theme = name
            playlist.reset(desktop)
            for screen in screens:
                screen.source = None
            complained = False
            log(f"theme is {theme or '(none)'}")
        if desktop != wallpaper:
            wallpaper = desktop
            playlist.reset(desktop)
            for screen in screens:
                if screen.source and os.path.realpath(screen.source) == wallpaper:
                    log(f"{screen.name}: the desktop took this picture")
                    screen.source = None

        rotate_all = (now - picked_at) >= interval or advance["now"]
        advance["now"] = False
        if rotate_all:
            picked_at = now

        # A panel needs a new picture when everything rotates, when it has
        # none yet, or when it just reconnected and its frame went with it.
        # Reassigning every panel at once - rather than one at a time against
        # the others' stale picks - is what lets two panels swap pictures when
        # there are exactly as many pictures as panels.
        reassign = [s for s in screens
                    if s.ready and (rotate_all or s.source is None
                                    or s.frame is None)]
        claimed = {s.source for s in screens
                   if s.ready and s not in reassign and s.source}
        for screen in reassign:
            choice = playlist.take(avoid=claimed, prefer_not=(screen.source,))
            if choice is None:
                if not complained:
                    log(f"no backgrounds found for theme {theme or '(none)'}")
                    complained = True
                continue
            complained = False
            claimed.add(choice)
            log(f"{screen.name}: {os.path.basename(choice)}")
            screen.show(choice, quality)
        for screen in screens:
            if screen.ready and screen not in reassign:
                if screen.live:
                    screen.compose(quality)   # redraw the stats overlay
                screen.push()

        time.sleep(keepalive)

    for player in players:
        player.stop()
    for player in players:
        player.join(timeout=5)
        player.screen.close()
    for screen in screens:
        screen.close()


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--probe", action="store_true",
                        help="identify the panels and exit")
    parser.add_argument("--test", action="store_true",
                        help="show a corner-marked test pattern and hold it")
    parser.add_argument("--image", metavar="FILE",
                        help="show this image instead of a theme background")
    parser.add_argument("--video", metavar="FILE",
                        help="play this video on the panel, on a loop")
    parser.add_argument("--video-fps", type=float, metavar="N",
                        help="frame rate for --video")
    parser.add_argument("--video-quality", type=int, metavar="Q",
                        help="ffmpeg -q:v for --video, 2 (best) to 31")
    parser.add_argument("--once", action="store_true",
                        help="with --image/--test, send one frame and exit")
    parser.add_argument("--panel", choices=("thermaltake", "thermalright"),
                        help="drive only this panel")
    parser.add_argument("--resolution", metavar="WxH",
                        help="override the Thermalright panel geometry")
    parser.add_argument("--interval", type=float,
                        help="seconds between pictures")
    parser.add_argument("--version", action="version", version=__version__)
    args = parser.parse_args()

    config = load_config()
    if args.resolution:
        config["thermalright"]["resolution"] = args.resolution
    if args.interval is not None:
        config["interval"] = args.interval

    if args.video:
        for key in ("thermaltake", "thermalright"):
            if args.panel in (None, key):
                config[key]["video"] = args.video
                if args.video_fps:
                    config[key]["video_fps"] = args.video_fps
                if args.video_quality:
                    config[key]["video_quality"] = args.video_quality

    screens = build_screens(config, only=args.panel)
    if not screens:
        log("every panel is disabled")
        return 1

    if args.probe:
        failed = 0
        for screen in screens:
            screen.next_try = 0.0
            screen.connect(time.monotonic())
            if screen.ready:
                screen.close()
            else:
                failed += 1
        return 1 if failed == len(screens) else 0

    if args.test or args.image:
        for screen in screens:
            screen.next_try = 0.0
            screen.connect(time.monotonic())
        opened = [s for s in screens if s.ready]
        if not opened:
            return 1
        for screen in opened:
            if args.image:
                screen.show(args.image, int(config["quality"]))
            else:
                screen.frame = test_pattern(screen.driver.size, screen.name,
                                            screen.driver.rotate_image)
                screen.push()
        if args.once:
            for screen in opened:
                screen.close()
            return 0
        log("holding the frame - Ctrl-C to stop")
        try:
            while True:
                time.sleep(float(config["keepalive"]))
                for screen in opened:
                    if args.image and screen.live:
                        screen.compose(int(config["quality"]))
                    screen.push()
        except KeyboardInterrupt:
            pass
        finally:
            for screen in opened:
                screen.close()
        return 0

    run(config, screens)
    return 0


if __name__ == "__main__":
    sys.exit(main())
